root = true

[*]
insert_final_newline = true
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{Makefile,go.mod,go.sum,*.go,.gitmodules}]
indent_style = tab
indent_size = 4

[*.md]
indent_size = 4
trim_trailing_whitespace = false

eclint_indent_style = unset

[Dockerfile]
indent_size = 4

# The built page is generated
[cmd/avatar/web/dist/**]
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
